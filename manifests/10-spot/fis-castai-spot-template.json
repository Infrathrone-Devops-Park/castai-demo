{
  "description": "Interrupt one CAST AI spot node (castai-demo)",
  "roleArn": "",
  "stopConditions": [
    { "source": "none" }
  ],
  "targets": {
    "castaiSpot": {
      "resourceType": "aws:ec2:spot-instance",
      "resourceTags": {
        "castai-demo": "managed"
      },
      "filters": [
        { "path": "State.Name", "values": ["running"] },
        { "path": "InstanceId", "values": [] }
      ],
      "selectionMode": "COUNT(1)"
    }
  },
  "actions": {
    "interruptSpot": {
      "actionId": "aws:ec2:send-spot-instance-interruptions",
      "description": "2 minute spot interruption notice",
      "parameters": {
        "durationBeforeInterruption": "PT2M"
      },
      "targets": {
        "SpotInstances": "castaiSpot"
      }
    }
  },
  "tags": {
    "Name": "castai-spot-demo",
    "Project": "castai-demo"
  }
}
